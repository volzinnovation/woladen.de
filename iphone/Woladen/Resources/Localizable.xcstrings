            "value": "Prøv igjen for å laste ladestasjoner innen 20 km."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen for å laste ladestasjoner innen 20 km."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie załadować stacje ładowania w promieniu 20 km."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente carregar estações de carregamento num raio de 20 km."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente nuevamente cargar estaciones de carga en un radio de 20 km."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste znovu načíst nabíjecí stanice do 20 km."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, próbálja újra betölteni a töltőállomásokat 20 km-en belül."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusite znova naložiti polnilne postaje v krogu 20 km."
