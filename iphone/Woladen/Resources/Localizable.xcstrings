    "filters.availableOnlyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only stations with known availability and at least one free charging point"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Stationen mit bekannter Verfügbarkeit und mindestens einem freien Ladepunkt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les bornes dont la disponibilité est connue et au moins une borne de recharge gratuite"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen stations met bekende beschikbaarheid en minstens een vrij laadpunt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun stationer med kendt tilgængelighed og mindst ét gratis ladepunkt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain asemat, joiden saatavuus on tiedossa ja joissa on vähintään yksi ilmainen latauspiste"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast stationer med känd tillgänglighet och minst en gratis laddpunkt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο σταθμοί με γνωστή διαθεσιμότητα και τουλάχιστον ένα δωρεάν σημείο φόρτισης"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai stacijas ar zināmu pieejamību un vismaz vienu bezmaksas uzlādes punktu"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik žinomos stotys ir bent vienas nemokamas įkrovimo taškas"
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëmmen Statiounen mat bekannt Disponibilitéit an op d'mannst ee fräi Opluedstatiounen Punkt"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stazzjonijiet biss b'disponibbiltà magħrufa u mill-inqas punt wieħed għall-iċċarġjar b'xejn"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun stasjoner med kjent tilgjengelighet og minst ett gratis ladepunkt"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun stasjoner med kjent tilgjengelighet og minst ett gratis ladepunkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko stacje o znanej dostępności i co najmniej jednym bezpłatnym punkcie ładowania"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas estações com disponibilidade conhecida e pelo menos um ponto de carregamento gratuito"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo estaciones con disponibilidad conocida y al menos un punto de recarga gratuito"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze stanice se známou dostupností a alespoň jedním volným nabíjecím místem"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ismert elérhetőségű állomások és legalább egy ingyenes töltőpont"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo postaje z znano razpoložljivostjo in vsaj enim prostim polnilnim mestom"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo stazioni con disponibilità nota e almeno un punto di ricarica gratuito"
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Mo staziuns cun disponibladad enconuschenta ed almain in punct da chargiar liber"
