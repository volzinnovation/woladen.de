    "seo.coverageIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen vám pomůže najít dostupné nabíječky v pokrytých zemích: rychlonabíječky pro auto a užitečná místa pro lidi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hjælper dig med at finde ledige ladere i de lande, vi dækker: hurtigladere til bilen og nyttige steder til menneskerne i den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hilft dir, verfügbare Ladestopps in den aktuell abgedeckten Ländern zu finden: Schnelllader fürs Auto, nützliche Orte für die Menschen darin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το woladen σας βοηθά να βρείτε διαθέσιμους φορτιστές στις χώρες που καλύπτουμε: ταχυφορτιστές για το αυτοκίνητο και χρήσιμα μέρη για τους ανθρώπους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen helps you find available chargers in the countries we currently serve: fast chargers for cars, useful places for the people inside them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen te ayuda a encontrar cargadores disponibles en los países cubiertos: cargadores rápidos para el coche y lugares útiles para las personas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen auttaa löytämään vapaita latureita katetuissa maissa: pikalatureita autolle ja hyödyllisiä paikkoja matkustajille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen vous aide à trouver des arrêts de recharge disponibles dans les pays actuellement couverts : des chargeurs rapides pour la voiture, des lieux utiles pour les personnes à bord."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A woladen segít elérhető töltőket találni a lefedett országokban: gyorstöltők az autónak és hasznos helyek az embereknek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen ti aiuta a trovare caricatori disponibili nei paesi coperti: ricarica rapida per l’auto e luoghi utili per le persone."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hëlleft dir disponibel Luedstatiounen an den ofgedeckte Länner ze fannen: Schnelllader fir den Auto an nëtzlech Plaze fir d’Leit."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen padeda rasti laisvus įkroviklius aptarnaujamose šalyse: greiti įkrovikliai automobiliui ir naudingos vietos žmonėms."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen palīdz atrast pieejamus lādētājus aptvertajās valstīs: ātrie lādētāji auto un noderīgas vietas cilvēkiem."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen jgħinek issib ċarġers disponibbli fil-pajjiżi koperti: ċarġers rapidi għall-karozza u postijiet utli għan-nies."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hjelper deg å finne ledige ladere i landene vi dekker: hurtigladere for bilen og nyttige steder for menneskene i den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen helpt je beschikbare laadstops te vinden in de landen die we momenteel bedienen: snelladers voor de auto, nuttige plekken voor de mensen erin."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hjelper deg å finne ledige ladarar i landa vi dekkjer: hurtigladarar for bilen og nyttige stader for folka i han."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen pomaga znaleźć dostępne ładowarki w obsługiwanych krajach: szybkie ładowarki dla auta i przydatne miejsca dla ludzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A woladen ajuda-o a encontrar carregadores disponíveis nos países cobertos: carregadores rápidos para o carro e locais úteis para as pessoas."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen gida a chattar chargiaders disponibels en ils pajais cuvrids: chargiaders svelts per l’auto e lieus utils per las persunas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen vam pomaga najti razpoložljive polnilnice v pokritih državah: hitre polnilnice za avto in uporabne kraje za ljudi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen hjälper dig hitta lediga laddare i täckta länder: snabbladdare för bilen och nyttiga platser för människorna i den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "woladen kapsanan ülkelerde uygun şarj cihazları bulmana yardım eder: araba için hızlı şarj, insanlar için yararlı yerler."
          }
        }
      }
    },
