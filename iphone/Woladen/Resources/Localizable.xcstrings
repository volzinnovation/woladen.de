    "seo.homeIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find available chargers near bakeries, restaurants, shops, playgrounds and cafés across Europe. Because charging time should be time well spent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde verfügbare Ladestopps in Europa nahe Bäckereien, Restaurants, Läden, Spielplätzen und Cafés. Denn Ladezeit sollte gut genutzte Zeit sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge disponibles en Europe près de boulangeries, restaurants, boutiques, aires de jeux et cafés. Le temps de recharge doit être du temps bien utilisé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind beschikbare laadstops in Europa bij bakkerijen, restaurants, winkels, speeltuinen en cafés. Want laadtijd moet goed bestede tijd zijn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ledige ladestop i Europa nær bagerier, restauranter, butikker, legepladser og caféer. Ladetid skal være godt brugt tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä vapaat latauspysähdykset Euroopassa leipomoiden, ravintoloiden, kauppojen, leikkipaikkojen ja kahviloiden läheltä. Latausajan pitäisi olla hyvin käytettyä aikaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta lediga laddstopp i Europa nära bagerier, restauranger, butiker, lekplatser och kaféer. Laddtid ska vara väl använd tid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε διαθέσιμες στάσεις φόρτισης στην Ευρώπη κοντά σε φούρνους, εστιατόρια, καταστήματα, παιδικές χαρές και καφέ. Ο χρόνος φόρτισης πρέπει να είναι χρήσιμος χρόνος."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi pieejamas uzlādes pieturas Eiropā pie maiznīcām, restorāniem, veikaliem, rotaļu laukumiem un kafejnīcām. Uzlādes laikam jābūt lietderīgam laikam."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite laisvus įkrovimo sustojimus Europoje prie kepyklų, restoranų, parduotuvių, žaidimų aikštelių ir kavinių. Įkrovimo laikas turi būti naudingas laikas."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann disponibel Luedstopp an Europa no bei Bäckereien, Restauranten, Butteker, Spillplazen a Caféen. Luedzäit soll gutt genotzt Zäit sinn."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar disponibbli fl-Ewropa ħdejn fran, ristoranti, ħwienet, żoni tal-logħob u kafetteriji. Il-ħin tal-iċċarġjar għandu jkun ħin użat tajjeb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp i Europa nær bakerier, restauranter, butikker, lekeplasser og kafeer. Ladetid bør være godt brukt tid."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp i Europa nær bakeri, restaurantar, butikkar, leikeplassar og kafear. Ladetid bør vere godt brukt tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dostępne postoje ładowania w Europie blisko piekarni, restauracji, sklepów, placów zabaw i kawiarni. Czas ładowania powinien być dobrze wykorzystany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento disponíveis na Europa perto de padarias, restaurantes, lojas, parques infantis e cafés. O tempo de carregamento deve ser tempo bem usado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga disponibles en Europa cerca de panaderías, restaurantes, tiendas, parques infantiles y cafeterías. El tiempo de carga debe ser tiempo bien aprovechado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte dostupné nabíjecí zastávky v Evropě poblíž pekáren, restaurací, obchodů, hřišť a kaváren. Čas nabíjení má být dobře využitý čas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj elérhető töltési megállókat Európában pékségek, éttermek, üzletek, játszóterek és kávézók közelében. A töltési idő legyen jól használt idő."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščite razpoložljive polnilne postanke v Evropi blizu pekarn, restavracij, trgovin, igrišč in kavarn. Čas polnjenja naj bo dobro izkoriščen čas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova soste di ricarica disponibili in Europa vicino a panetterie, ristoranti, negozi, aree giochi e caffè. Il tempo di ricarica dovrebbe essere tempo ben speso."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta fermadas da chargiar disponiblas en l’Europa sper furnarias, restaurants, butias, plazzas da gieu e cafés. Il temp da chargiar duai esser temp bain utilisà."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avrupa’da fırınlar, restoranlar, mağazalar, oyun alanları ve kafelerin yakınında uygun şarj molaları bul. Şarj zamanı iyi değerlendirilmiş zaman olmalı."
          }
        }
      }
    },
