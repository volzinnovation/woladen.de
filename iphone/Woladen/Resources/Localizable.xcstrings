    "station.typicalOccupancyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average occupied charging points by hour; unknown states do not count as occupied."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchschnitt der belegten Ladepunkte je Stunde; unbekannte Zustände zählen nicht als belegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne des points de recharge occupés par heure ; les états inconnus ne comptent pas comme occupés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld aantal bezette laadpunten per uur; onbekende statussen tellen niet als bezet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemsnitlige besatte ladepunkter pr. time; ukendte stater tæller ikke som besatte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskimääräiset varatut latauspisteet tunneittain; tuntemattomia osavaltioita ei lasketa miehitetyiksi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genomsnittligt upptagna laddningspunkter per timme; okända stater räknas inte som ockuperade."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέσος όρος κατειλημμένων σημείων φόρτισης ανά ώρα. άγνωστες πολιτείες δεν υπολογίζονται ως κατεχόμενες."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidējais aizņemto uzlādes punktu skaits stundās; nezināmi štati netiek uzskatīti par okupētiem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidutinis užimtų įkrovimo taškų skaičius valandomis; nežinomos valstybės neskaičiuojamos kaip okupuotos."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerchschnëtt besat Opluedstatiounen no Stonn; onbekannt Staaten zielen net als besat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti tal-iċċarġjar okkupati medja bis-siegħa; stati mhux magħrufa ma jgħoddux bħala okkupati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomsnittlig okkuperte ladepunkter per time; ukjente stater regnes ikke som okkuperte."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomsnittlig okkuperte ladepunkter per time; ukjente stater regnes ikke som okkuperte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia liczba zajętych punktów ładowania na godzinę; nieznane stany nie liczą się jako zajęte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Média de pontos de carregamento ocupados por hora; estados desconhecidos não contam como ocupados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Promedio de puntos de recarga ocupados por hora; Los estados desconocidos no cuentan como ocupados."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průměr obsazených nabíjecích bodů za hodinu; neznámé státy se nepočítají jako obsazené."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átlagosan elfoglalt töltési helyek óránként; az ismeretlen államok nem számítanak elfoglaltnak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povprečno zasedena polnilna mesta po urah; neznane države se ne štejejo za zasedene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti di ricarica occupati in media per ora; gli stati sconosciuti non contano come occupati."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Media dals puncts da chargiar occupads per ura; stadis nunenconuschents na quintan betg sco occupads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bazında ortalama dolu şarj noktaları; bilinmeyen eyaletler işgal edilmiş sayılmaz."
          }
        }
      }
    },
