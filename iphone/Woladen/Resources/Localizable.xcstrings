    "seo.amenityIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find EV charging stops in {country} with {amenity} nearby, so charging time can be useful time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Ladestopps in {country} mit {amenity} in der Nähe, damit Ladezeit nützliche Zeit wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge en {country} avec {amenity} à proximité, pour rendre le temps de recharge utile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind laadstops in {country} met {amenity} in de buurt, zodat laadtijd nuttige tijd wordt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find EV-ladestop i {country} med {amenity} i nærheden, så ladetid bliver nyttig tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä EV-latauspysähdykset maassa {country}, joiden lähellä on {amenity}, jotta latausaika on hyödyllistä aikaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta EV-laddstopp i {country} med {amenity} i närheten, så att laddtid blir nyttig tid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε στάσεις φόρτισης EV σε {country} με {amenity} κοντά, ώστε ο χρόνος φόρτισης να είναι χρήσιμος."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi EV uzlādes pieturas valstī {country} ar {amenity} tuvumā, lai uzlādes laiks būtu lietderīgs."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite EV įkrovimo sustojimus šalyje {country} su {amenity} netoliese, kad įkrovimo laikas būtų naudingas."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann EV-Luedstopp a {country} mat {amenity} an der Géigend, fir datt Luedzäit nëtzlech Zäit gëtt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar EV f’{country} b’{amenity} fil-qrib, sabiex il-ħin tal-iċċarġjar ikun utli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn EV-ladestopp i {country} med {amenity} i nærheten, så ladetid blir nyttig tid."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn EV-ladestopp i {country} med {amenity} i nærleiken, så ladetid blir nyttig tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź postoje ładowania EV w {country} z {amenity} w pobliżu, aby czas ładowania był użyteczny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento VE em {country} com {amenity} por perto, para que o tempo de carregamento seja útil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga VE en {country} con {amenity} cerca para que el tiempo de carga sea útil."
