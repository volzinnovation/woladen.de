    "list.loadingLiveFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live search is loading. Saved fast chargers are shown until then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Suche lädt. Bis dahin werden gespeicherte Schnelllader angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche en direct est en cours de chargement. Les chargeurs rapides enregistrés sont affichés jusque-là."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live zoeken wordt geladen. Opgeslagen snelladers worden tot die tijd getoond."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Livesøgning indlæses. Gemte hurtigopladere vises indtil da."
