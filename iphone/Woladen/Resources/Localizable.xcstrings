    "info.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is optional. When you use it, it focuses the map on your surroundings and sorts nearby stations. Favorites stay locally on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist optional. Wenn du ihn nutzt, zentriert woladen.de die Karte auf deine Umgebung und sortiert nahegelegene Ladestationen. Favoriten bleiben lokal auf deinem Gerät."
          }
        },
        "fr": {
