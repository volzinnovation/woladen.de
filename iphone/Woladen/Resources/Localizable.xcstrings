    "errors.catalogMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné síťové připojení. Litujeme, živé vyhledávání nebude fungovat, dokud toto zařízení nebude online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen netværksforbindelse. Beklager, livesøgning virker ikke, før denne enhed er online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Netzwerkverbindung. Tut uns leid, die Live-Suche funktioniert erst wieder, wenn dieses Gerät online ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει σύνδεση δικτύου. Λυπούμαστε, η ζωντανή αναζήτηση δεν θα λειτουργήσει μέχρι να συνδεθεί αυτή η συσκευή στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No network connection. Sorry, live search will not work until this device is online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión de red. Lo sentimos, la búsqueda en vivo no funcionará hasta que este dispositivo esté en línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei verkkoyhteyttä. Valitettavasti reaaliaikainen haku ei toimi ennen kuin tämä laite on online-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion réseau. Désolé, la recherche en direct ne fonctionnera pas tant que cet appareil ne sera pas en ligne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs hálózati kapcsolat. Sajnáljuk, az élő keresés nem fog működni, amíg ez az eszköz online nem lesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione di rete. Siamo spiacenti, la ricerca in tempo reale non funzionerà finché il dispositivo non sarà online."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keng Netzverbindung. Entschëllegt, Live Sich funktionnéiert net bis dësen Apparat online ass."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra tinklo ryšio. Atsiprašome, tiesioginė paieška neveiks, kol šis įrenginys neprisijungs."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav tīkla savienojuma. Diemžēl tiešraides meklēšana nedarbosies, kamēr šī ierīce nebūs tiešsaistē."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebda konnessjoni tan-netwerk. Jiddispjacini, it-tfittxija diretta mhux se taħdem sakemm dan l-apparat ikun online."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen nettverkstilkobling. Beklager, direktesøk vil ikke fungere før denne enheten er online."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen netwerkverbinding. Sorry, live zoeken werkt pas weer zodra dit apparaat online is."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen nettverkstilkobling. Beklager, direktesøk vil ikke fungere før denne enheten er online."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia sieciowego. Przepraszamy, wyszukiwanie na żywo nie będzie działać, dopóki to urządzenie nie będzie online."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conexão de rede. Desculpe, a pesquisa ao vivo não funcionará até que este dispositivo esteja on-line."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naginas connexiun a la rait. Perstgisa, la tschertga live na funcziunescha betg enfin che quest apparat è puspè online."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni omrežne povezave. Iskanje v živo žal ne bo delovalo, dokler ta naprava ni povezana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen nätverksanslutning. Livesökning fungerar tyvärr inte förrän den här enheten är online."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantısı yok. Üzgünüz, bu cihaz çevrimiçi olana kadar canlı arama çalışmayacaktır."
          }
        }
      }
    },
