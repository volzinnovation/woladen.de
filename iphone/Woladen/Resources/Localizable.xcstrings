    "seo.homeDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find available chargers near bakeries, restaurants, shops, playgrounds and cafés across Europe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde verfügbare Ladestopps in Europa nahe Bäckereien, Restaurants, Läden, Spielplätzen und Cafés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge disponibles en Europe près de boulangeries, restaurants, boutiques, aires de jeux et cafés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind beschikbare laadstops in Europa bij bakkerijen, restaurants, winkels, speeltuinen en cafés."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ledige ladestop i Europa nær nyttige steder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä vapaat latauspysähdykset Euroopassa hyödyllisten paikkojen läheltä."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta lediga laddstopp i Europa nära nyttiga platser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε διαθέσιμες στάσεις φόρτισης στην Ευρώπη κοντά σε χρήσιμα μέρη."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi pieejamas uzlādes pieturas Eiropā pie noderīgām vietām."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite laisvus įkrovimo sustojimus Europoje prie naudingų vietų."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann disponibel Luedstopp an Europa no bei nëtzleche Plazen."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar disponibbli fl-Ewropa ħdejn postijiet utli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp i Europa nær nyttige steder."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp i Europa nær nyttige stader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dostępne postoje ładowania w Europie blisko przydatnych miejsc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento disponíveis na Europa perto de locais úteis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga disponibles en Europa cerca de lugares útiles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte dostupné nabíjecí zastávky v Evropě poblíž užitečných míst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj elérhető töltési megállókat Európában hasznos helyek közelében."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščite razpoložljive polnilne postanke v Evropi blizu uporabnih krajev."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova soste di ricarica disponibili in Europa vicino a luoghi utili."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta fermadas da chargiar disponiblas en l’Europa sper lieus utils."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avrupa’da yararlı yerlerin yakınında uygun şarj molaları bul."
          }
        }
      }
