    "location.usageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen uses your location to show charging points nearby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen nutzt Ihren Standort, um Ladepunkte in der Nähe anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen utilise votre position pour afficher les points de recharge à proximité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen gebruikt jouw locatie om oplaadpunten in de buurt te tonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen bruger din placering til at vise ladepunkter i nærheden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen käyttää sijaintiasi näyttääkseen lähellä olevat latauspisteet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen använder din plats för att visa laddningspunkter i närheten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το woladen χρησιμοποιεί την τοποθεσία σας για να εμφανίζει κοντινά σημεία φόρτισης."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen izmanto jūsu atrašanās vietu, lai parādītu tuvumā esošos uzlādes punktus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen naudoja jūsų vietą, kad parodytų netoliese esančius įkrovimo taškus."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen benotzt Är Location fir Opluedpunkten an der Géigend ze weisen."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen juża l-lokalità tiegħek biex juri l-punti tal-iċċarġjar fil-qrib."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen bruker posisjonen din til å vise ladepunkter i nærheten."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen bruker posisjonen din til å vise ladepunkter i nærheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen wykorzystuje Twoją lokalizację, aby pokazać pobliskie punkty ładowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen usa sua localização para mostrar pontos de carregamento próximos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen utiliza tu ubicación para mostrar los puntos de carga cercanos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen používá vaši polohu k zobrazení nabíjecích bodů v okolí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A woladen az Ön tartózkodási helyét használja a közeli töltési pontok megjelenítéséhez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen uporablja vašo lokacijo za prikaz polnilnih mest v bližini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen utilizza la tua posizione per mostrare i punti di ricarica nelle vicinanze."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen utilisescha tes lieu per mussar puncts da chargiar en vischinanza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen yakındaki şarj noktalarını göstermek için konumunuzu kullanır."
          }
        }
      }
    },
