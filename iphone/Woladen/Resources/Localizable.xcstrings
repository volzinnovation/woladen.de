    "seo.countryDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find available EV charging stops in {country} near bakeries, restaurants, shops, playgrounds and cafés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde verfügbare Ladestopps in {country} nahe Bäckereien, Restaurants, Läden, Spielplätzen und Cafés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge disponibles en {country}, près de boulangeries, restaurants, boutiques, aires de jeux et cafés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind beschikbare laadstops in {country} bij bakkerijen, restaurants, winkels, speeltuinen en cafés."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ledige EV-ladestop i {country} nær nyttige steder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä vapaat EV-latauspysähdykset maassa {country} hyödyllisten paikkojen läheltä."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta lediga EV-laddstopp i {country} nära nyttiga platser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε διαθέσιμες στάσεις φόρτισης EV σε {country} κοντά σε χρήσιμα μέρη."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi pieejamas EV uzlādes pieturas valstī {country} pie noderīgām vietām."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite laisvus EV įkrovimo sustojimus šalyje {country} prie naudingų vietų."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann disponibel EV-Luedstopp a {country} no bei nëtzleche Plazen."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar EV f’{country} ħdejn postijiet utli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige EV-ladestopp i {country} nær nyttige steder."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige EV-ladestopp i {country} nær nyttige stader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dostępne postoje ładowania EV w {country} blisko przydatnych miejsc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento VE disponíveis em {country} perto de locais úteis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga VE disponibles en {country} cerca de lugares útiles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte dostupné EV nabíjecí zastávky v {country} poblíž užitečných míst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj elérhető EV töltési megállókat itt: {country}, hasznos helyek közelében."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščite razpoložljive EV polnilne postanke v {country} blizu uporabnih krajev."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova soste di ricarica EV disponibili in {country} vicino a luoghi utili."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta fermadas da chargiar EV disponiblas en {country} sper lieus utils."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{country} içinde yararlı yerlerin yakınında uygun EV şarj molaları bul."
          }
        }
      }
    },
