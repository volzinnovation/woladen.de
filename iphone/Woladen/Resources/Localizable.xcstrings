    "seo.productMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find available chargers near great bakeries, restaurants, shops, playgrounds and cafés. Because charging time should be time well spent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde verfügbare Ladestopps in der Nähe von Bäckereien, Restaurants, Läden, Spielplätzen und Cafés. Denn Ladezeit sollte gut genutzte Zeit sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge disponibles près de boulangeries, restaurants, boutiques, aires de jeux et cafés. Le temps de recharge doit être du temps bien utilisé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind beschikbare laadstops bij bakkerijen, restaurants, winkels, speeltuinen en cafés. Want laadtijd moet goed bestede tijd zijn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ledige ladestop nær bagerier, restauranter, butikker, legepladser og caféer. Ladetid skal være godt brugt tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä vapaat latauspysähdykset leipomoiden, ravintoloiden, kauppojen, leikkipaikkojen ja kahviloiden läheltä. Latausajan pitäisi olla hyvin käytettyä aikaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta lediga laddstopp nära bagerier, restauranger, butiker, lekplatser och kaféer. Laddtid ska vara väl använd tid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε διαθέσιμες στάσεις φόρτισης κοντά σε φούρνους, εστιατόρια, καταστήματα, παιδικές χαρές και καφέ. Ο χρόνος φόρτισης πρέπει να είναι χρήσιμος χρόνος."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi pieejamas uzlādes pieturas pie maiznīcām, restorāniem, veikaliem, rotaļu laukumiem un kafejnīcām. Uzlādes laikam jābūt lietderīgam laikam."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite laisvus įkrovimo sustojimus prie kepyklų, restoranų, parduotuvių, žaidimų aikštelių ir kavinių. Įkrovimo laikas turi būti naudingas laikas."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann disponibel Luedstopp no bei Bäckereien, Restauranten, Butteker, Spillplazen a Caféen. Luedzäit soll gutt genotzt Zäit sinn."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar disponibbli ħdejn fran, ristoranti, ħwienet, żoni tal-logħob u kafetteriji. Il-ħin tal-iċċarġjar għandu jkun ħin użat tajjeb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp nær bakerier, restauranter, butikker, lekeplasser og kafeer. Ladetid bør være godt brukt tid."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige ladestopp nær bakeri, restaurantar, butikkar, leikeplassar og kafear. Ladetid bør vere godt brukt tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dostępne postoje ładowania blisko piekarni, restauracji, sklepów, placów zabaw i kawiarni. Czas ładowania powinien być dobrze wykorzystany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento disponíveis perto de padarias, restaurantes, lojas, parques infantis e cafés. O tempo de carregamento deve ser tempo bem usado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga disponibles cerca de panaderías, restaurantes, tiendas, parques infantiles y cafeterías. El tiempo de carga debe ser tiempo bien aprovechado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte dostupné nabíjecí zastávky poblíž pekáren, restaurací, obchodů, hřišť a kaváren. Čas nabíjení má být dobře využitý čas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj elérhető töltési megállókat pékségek, éttermek, üzletek, játszóterek és kávézók közelében. A töltési idő legyen jól használt idő."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščite razpoložljive polnilne postanke blizu pekarn, restavracij, trgovin, igrišč in kavarn. Čas polnjenja naj bo dobro izkoriščen čas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova soste di ricarica disponibili vicino a panetterie, ristoranti, negozi, aree giochi e caffè. Il tempo di ricarica dovrebbe essere tempo ben speso."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta fermadas da chargiar disponiblas sper furnarias, restaurants, butias, plazzas da gieu e cafés. Il temp da chargiar duai esser temp bain utilisà."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fırınlar, restoranlar, mağazalar, oyun alanları ve kafelerin yakınında uygun şarj molaları bul. Şarj zamanı iyi değerlendirilmiş zaman olmalı."
          }
        }
      }
    },
    "seo.seoCtaBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the map for available chargers near bakeries, restaurants, shops, playgrounds and cafés, or keep woladen on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Karte für verfügbare Lader nahe Bäckereien, Restaurants, Läden, Spielplätzen und Cafés, oder behalte woladen auf deinem Handy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la carte pour trouver des bornes disponibles près de boulangeries, restaurants, boutiques, aires de jeux et cafés, ou gardez woladen sur votre téléphone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de kaart voor beschikbare laders bij bakkerijen, restaurants, winkels, speeltuinen en cafés, of houd woladen op je telefoon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn kortet for ledige ladere nær nyttige steder, eller behold woladen på din telefon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kartta vapaille latureille hyödyllisten paikkojen lähellä tai pidä woladen puhelimessasi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna kartan för lediga laddare nära nyttiga platser, eller ha woladen på din telefon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τον χάρτη για διαθέσιμους φορτιστές κοντά σε χρήσιμα μέρη ή κρατήστε το woladen στο τηλέφωνό σας."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atver karti pieejamiem lādētājiem pie noderīgām vietām vai turi woladen tālrunī."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite žemėlapį laisviems įkrovikliams prie naudingų vietų arba laikykite woladen telefone."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maach d’Kaart op fir disponibel Luedstatiounen no bei nëtzleche Plazen, oder haalt woladen um Telefon."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iftaħ il-mappa għal ċarġers disponibbli ħdejn postijiet utli, jew żomm woladen fuq it-telefon tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne kartet for ledige ladere nær nyttige steder, eller ha woladen på telefonen."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opne kartet for ledige ladarar nær nyttige stader, eller ha woladen på telefonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz mapę dostępnych ładowarek blisko przydatnych miejsc albo trzymaj woladen w telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o mapa para carregadores disponíveis perto de locais úteis ou mantenha a woladen no seu telemóvel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el mapa para ver cargadores disponibles cerca de lugares útiles o lleva woladen en tu teléfono."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete mapu dostupných nabíječek poblíž užitečných míst nebo si nechte woladen v telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a térképet az elérhető töltőkhöz hasznos helyek közelében, vagy tartsd a woladent a telefonodon."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite zemljevid za razpoložljive polnilnice blizu uporabnih krajev ali obdržite woladen na telefonu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la mappa per caricatori disponibili vicino a luoghi utili, oppure tieni woladen sul telefono."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Avra la charta per chargiaders disponibels sper lieus utils u tegna woladen sin tes telefon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yararlı yerlerin yakınındaki uygun şarj cihazları için haritayı aç veya woladen’i telefonunda tut."
          }
        }
      }
    },
