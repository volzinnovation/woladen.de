    "seo.timeLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because charging time is your time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denn Ladezeit ist deine Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que le temps de recharge est votre temps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Want laadtijd is jouw tijd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi ladetid er din tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska latausaika on sinun aikaasi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För laddtid är din tid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή ο χρόνος φόρτισης είναι δικός σας χρόνος."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo uzlādes laiks ir tavs laiks."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nes įkrovimo laikas yra jūsų laikas."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Well Luedzäit deng Zäit ass."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għax il-ħin tal-iċċarġjar huwa l-ħin tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi ladetid er din tid."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi ladetid er di tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo czas ładowania to twój czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque o tempo de carregamento é o seu tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque el tiempo de carga es tu tiempo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože čas nabíjení je váš čas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mert a töltési idő a te időd."
          }
        },
        "sl": {
          "stringUnit": {
