    "seo.productMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najděte dostupné nabíjecí zastávky poblíž pekáren, restaurací, obchodů, hřišť a kaváren. Čas nabíjení má být dobře využitý čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find ledige ladestop nær bagerier, restauranter, butikker, legepladser og caféer. Ladetid skal være godt brugt tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde verfügbare Ladestopps in der Nähe von Bäckereien, Restaurants, Läden, Spielplätzen und Cafés. Denn Ladezeit sollte gut genutzte Zeit sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρείτε διαθέσιμες στάσεις φόρτισης κοντά σε φούρνους, εστιατόρια, καταστήματα, παιδικές χαρές και καφέ. Ο χρόνος φόρτισης πρέπει να είναι χρήσιμος χρόνος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find available chargers near great bakeries, restaurants, shops, playgrounds and cafés. Because charging time should be time well spent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra paradas de carga disponibles cerca de panaderías, restaurantes, tiendas, parques infantiles y cafeterías. El tiempo de carga debe ser tiempo bien aprovechado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydä vapaat latauspysähdykset leipomoiden, ravintoloiden, kauppojen, leikkipaikkojen ja kahviloiden läheltä. Latausajan pitäisi olla hyvin käytettyä aikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez des arrêts de recharge disponibles près de boulangeries, restaurants, boutiques, aires de jeux et cafés. Le temps de recharge doit être du temps bien utilisé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Találj elérhető töltési megállókat pékségek, éttermek, üzletek, játszóterek és kávézók közelében. A töltési idő legyen jól használt idő."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova soste di ricarica disponibili vicino a panetterie, ristoranti, negozi, aree giochi e caffè. Il tempo di ricarica dovrebbe essere tempo ben speso."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fann disponibel Luedstopp no bei Bäckereien, Restauranten, Butteker, Spillplazen a Caféen. Luedzäit soll gutt genotzt Zäit sinn."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raskite laisvus įkrovimo sustojimus prie kepyklų, restoranų, parduotuvių, žaidimų aikštelių ir kavinių. Įkrovimo laikas turi būti naudingas laikas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrodi pieejamas uzlādes pieturas pie maiznīcām, restorāniem, veikaliem, rotaļu laukumiem un kafejnīcām. Uzlādes laikam jābūt lietderīgam laikam."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sib waqfiet tal-iċċarġjar disponibbli ħdejn fran, ristoranti, ħwienet, żoni tal-logħob u kafetteriji. Il-ħin tal-iċċarġjar għandu jkun ħin użat tajjeb."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn ledige ladestopp nær bakerier, restauranter, butikker, lekeplasser og kafeer. Ladetid bør være godt brukt tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind beschikbare laadstops bij bakkerijen, restaurants, winkels, speeltuinen en cafés. Want laadtijd moet goed bestede tijd zijn."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn ledige ladestopp nær bakeri, restaurantar, butikkar, leikeplassar og kafear. Ladetid bør vere godt brukt tid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź dostępne postoje ładowania blisko piekarni, restauracji, sklepów, placów zabaw i kawiarni. Czas ładowania powinien być dobrze wykorzystany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre paragens de carregamento disponíveis perto de padarias, restaurantes, lojas, parques infantis e cafés. O tempo de carregamento deve ser tempo bem usado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatta fermadas da chargiar disponiblas sper furnarias, restaurants, butias, plazzas da gieu e cafés. Il temp da chargiar duai esser temp bain utilisà."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiščite razpoložljive polnilne postanke blizu pekarn, restavracij, trgovin, igrišč in kavarn. Čas polnjenja naj bo dobro izkoriščen čas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta lediga laddstopp nära bagerier, restauranger, butiker, lekplatser och kaféer. Laddtid ska vara väl använd tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fırınlar, restoranlar, mağazalar, oyun alanları ve kafelerin yakınında uygun şarj molaları bul. Şarj zamanı iyi değerlendirilmiş zaman olmalı."
          }
        }
      }
    },
    "seo.seoCtaBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete mapu dostupných nabíječek poblíž užitečných míst nebo si nechte woladen v telefonu."
