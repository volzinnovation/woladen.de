    "location.settingsMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location access for woladen in system settings to load charging stations near you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie den Standortzugriff für woladen in den Systemeinstellungen, um Ladestationen in Ihrer Nähe zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'accès à la localisation pour woladen dans les paramètres système pour charger des bornes de recharge près de chez vous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel locatietoegang voor woladen in de systeeminstellingen in om laadstations bij u in de buurt te laden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver lokationsadgang for woladen i systemindstillinger for at indlæse ladestationer i nærheden af dig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli woladen:n sijainnin käyttö järjestelmäasetuksista ladataksesi lähelläsi olevat latausasemat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera platsåtkomst för woladen i systeminställningarna för att ladda laddstationer nära dig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την πρόσβαση τοποθεσίας για το woladen στις ρυθμίσεις συστήματος για να φορτώσετε σταθμούς φόρτισης κοντά σας."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistēmas iestatījumos iespējojiet piekļuvi woladen atrašanās vietai, lai ielādētu tuvumā esošās uzlādes stacijas."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemos nustatymuose įgalinkite woladen prieigą prie vietos, kad įkeltumėte šalia jūsų esančias įkrovimo stotis."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivéiert Standuert Accès fir woladen am System Astellunge fir eng lued Opluedstatiounen bei Iech."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ippermetti aċċess għall-post għal woladen fis-settings tas-sistema biex tagħbija stazzjonijiet tal-iċċarġjar qrib tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver plasseringstilgang for woladen i systeminnstillingene for å laste ladestasjoner nær deg."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver plasseringstilgang for woladen i systeminnstillingene for å laste ladestasjoner nær deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do lokalizacji dla woladen w ustawieniach systemu, aby załadować pobliskie stacje ładowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso à localização para woladen nas configurações do sistema para carregar estações de carregamento perto de você."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite el acceso a la ubicación para woladen en la configuración del sistema para cargar estaciones de carga cercanas a usted."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup k poloze pro woladen v nastavení systému, aby se načítaly dobíjecí stanice ve vašem okolí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közeli töltőállomások betöltéséhez engedélyezze a woladen helymeghatározását a rendszerbeállításokban."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogočite dostop do lokacije za woladen v sistemskih nastavitvah, da naložite polnilne postaje v vaši bližini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita l'accesso alla posizione per woladen nelle impostazioni di sistema per caricare le stazioni di ricarica vicino a te."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Activescha l’access al lieu per woladen en las preferenzas dal sistem per chargiar staziuns da chargiar en tia vischinanza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınınızdaki şarj istasyonlarını yüklemek için sistem ayarlarında woladen için konum erişimini etkinleştirin."
          }
        }
      }
    },
