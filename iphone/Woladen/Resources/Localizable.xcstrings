    "info.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is optional. When you use it, it focuses the map on your surroundings and sorts nearby stations. Favorites stay locally on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist optional. Wenn du ihn nutzt, zentriert woladen.de die Karte auf deine Umgebung und sortiert nahegelegene Ladestationen. Favoriten bleiben lokal auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la localisation est facultatif. Lorsque vous l'utilisez, il concentre la carte sur votre environnement et trie les stations à proximité. Les favoris restent localement sur votre appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang is optioneel. Wanneer je die gebruikt, centreert woladen.de de kaart op je omgeving en sorteert nabijgelegen laadstations. Favorieten blijven lokaal op je apparaat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeringsadgang er valgfri. Når du bruger det, fokuserer det kortet på dine omgivelser og sorterer nærliggende stationer. Favoritter forbliver lokalt på din enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijainnin käyttöoikeus on valinnainen. Kun käytät sitä, se tarkentaa kartan ympäristöösi ja lajittelee lähellä olevat asemat. Suosikit pysyvät paikallisesti laitteellasi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Platsåtkomst är valfritt. När du använder den fokuserar den kartan på din omgivning och sorterar närliggande stationer. Favoriter stannar lokalt på din enhet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στην τοποθεσία είναι προαιρετική. Όταν το χρησιμοποιείτε, εστιάζει τον χάρτη στο περιβάλλον σας και ταξινομεί τους κοντινούς σταθμούς. Τα αγαπημένα παραμένουν τοπικά στη συσκευή σας."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuve atrašanās vietai nav obligāta. Kad jūs to izmantojat, tas fokusē karti uz jūsu apkārtni un kārto tuvumā esošās stacijas. Izlase paliek lokāli jūsu ierīcē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieiga prie vietos yra neprivaloma. Kai jį naudojate, jis sutelkia žemėlapį į aplinką ir rūšiuoja netoliese esančias stotis. Mėgstamiausios vietos lieka jūsų įrenginyje."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Zougang ass fakultativ. Wann Dir et benotzt, konzentréiert se d'Kaart op Är Ëmgéigend a sortéiert Emgéigend Statiounen. Favoritten bleiwen lokal op Ärem Apparat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-aċċess għall-post huwa fakultattiv. Meta tużaha, tiffoka l-mappa fuq l-inħawi tiegħek u tissortja stazzjonijiet fil-qrib. Il-favoriti jibqgħu lokalment fuq it-tagħmir tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang er valgfritt. Når du bruker den, fokuserer den kartet på omgivelsene dine og sorterer stasjoner i nærheten. Favoritter forblir lokalt på enheten din."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonstilgang er valgfritt. Når du bruker den, fokuserer den kartet på omgivelsene dine og sorterer stasjoner i nærheten. Favoritter forblir lokalt på enheten din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest opcjonalny. Kiedy z niego korzystasz, skupia mapę na Twoim otoczeniu i sortuje pobliskie stacje. Ulubione pozostają lokalnie na Twoim urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao local é opcional. Quando você o usa, ele concentra o mapa nos arredores e classifica as estações próximas. Os favoritos permanecem localmente no seu dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación es opcional. Cuando lo usas, enfoca el mapa en tu entorno y clasifica las estaciones cercanas. Los favoritos permanecen localmente en su dispositivo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k poloze je volitelný. Když jej použijete, zaměří mapu na vaše okolí a seřadí blízké stanice. Oblíbené zůstanou lokálně ve vašem zařízení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás nem kötelező. Amikor használja, a térképet a környezetére fókuszálja, és a közeli állomásokat rendezi. A kedvencek helyben maradnak az eszközön."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostop do lokacije ni obvezen. Ko ga uporabljate, osredotoči zemljevid na vašo okolico in razvrsti bližnje postaje. Priljubljene ostanejo lokalno v vaši napravi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla posizione è facoltativo. Quando lo usi, focalizza la mappa sull'ambiente circostante e ordina le stazioni vicine. I preferiti rimangono localmente sul tuo dispositivo."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "L’access al lieu è opziunal. Sche ti l’utiliseschas, focussescha el la charta sin tes conturn e zavra staziuns vischinas. Favorits restan localmain sin tes apparat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi isteğe bağlıdır. Kullandığınızda haritayı çevrenize odaklar ve yakındaki istasyonları sıralar. Favoriler cihazınızda yerel olarak kalır."
          }
        }
      }
    },
