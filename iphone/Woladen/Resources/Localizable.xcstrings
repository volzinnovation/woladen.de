    "seo.countryDataBoxBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Známé lokality a údaje o stanicích pocházejí z veřejných registrů nabíjení. Dostupnost a ceny zobrazujeme tam, kde je poskytovatelé zveřejňují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendte placeringer og stationsdetaljer kommer fra offentlige laderegistre. Tilgængelighed og priser vises, hvor udbydere offentliggør dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekannte Standorte und Stationsmerkmale stammen aus öffentlichen Ladeverzeichnissen. Verfügbarkeit und Preise zeigen wir dort, wo Anbieter sie veröffentlichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γνωστές τοποθεσίες και τα στοιχεία σταθμών προέρχονται από δημόσια μητρώα φόρτισης. Διαθεσιμότητα και τιμές εμφανίζονται όπου τις δημοσιεύουν οι πάροχοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Known locations and station characteristics come from public charging-station registers. Availability and price are shown where providers publish them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ubicaciones conocidas y los detalles de las estaciones proceden de registros públicos de carga. La disponibilidad y los precios se muestran cuando los operadores los publican."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnetut sijainnit ja asemien tiedot tulevat julkisista latausrekistereistä. Saatavuus ja hinnat näytetään, kun palveluntarjoajat julkaisevat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les emplacements connus et les caractéristiques des stations viennent de registres publics de recharge. La disponibilité et les prix sont affichés lorsque les fournisseurs les publient."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ismert helyszínek és állomásadatok nyilvános töltési nyilvántartásokból származnak. Az elérhetőséget és árakat ott mutatjuk, ahol a szolgáltatók közzéteszik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le località note e i dettagli delle stazioni provengono da registri pubblici di ricarica. Disponibilità e prezzi sono mostrati dove i fornitori li pubblicano."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekannt Plazen a Statiounsdetailer kommen aus ëffentleche Luedregisteren. Disponibilitéit a Präisser gi gewisen, wou Ubidder se publizéieren."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žinomos vietos ir stotelių duomenys gaunami iš viešųjų įkrovimo registrų. Prieinamumas ir kainos rodomi ten, kur teikėjai juos skelbia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zināmās atrašanās vietas un staciju dati nāk no publiskiem uzlādes reģistriem. Pieejamība un cenas tiek rādītas, ja pakalpojumu sniedzēji tās publicē."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postijiet magħrufa u dettalji tal-istazzjonijiet jiġu minn reġistri pubbliċi tal-iċċarġjar. Id-disponibbiltà u l-prezzijiet jintwerew fejn il-fornituri jippubblikawhom."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjente steder og stasjonsdetaljer kommer fra offentlige laderegistre. Tilgjengelighet og priser vises der leverandører publiserer dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekende locaties en kenmerken van stations komen uit openbare laadregisters. Beschikbaarheid en prijzen tonen we waar aanbieders die publiceren."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjende stader og stasjonsdetaljar kjem frå offentlege laderegister. Tilgjenge og prisar blir viste der tilbydarar publiserer dei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znane lokalizacje i szczegóły stacji pochodzą z publicznych rejestrów ładowania. Dostępność i ceny pokazujemy tam, gdzie publikują je operatorzy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localizações conhecidas e detalhes das estações vêm de registos públicos de carregamento. Disponibilidade e preços são mostrados quando os operadores os publicam."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieus enconuschents e detagls da staziuns derivan da registers publics da chargiar. Disponibladad e pretschs vegnan mussads nua che purschiders publitgeschan quels."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znane lokacije in podatki o postajah prihajajo iz javnih registrov polnjenja. Razpoložljivost in cene prikažemo tam, kjer jih ponudniki objavijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kända platser och stationsdetaljer kommer från offentliga laddregister. Tillgänglighet och priser visas där leverantörer publicerar dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinen konumlar ve istasyon ayrıntıları kamuya açık şarj kayıtlarından gelir. Uygunluk ve fiyatlar sağlayıcılar yayımladığında gösterilir."
          }
        }
      }
    },
