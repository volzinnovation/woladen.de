            "value": "Nëmmen op dësem Apparat gespäichert"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maħżuna biss fuq dan l-apparat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret kun på denne enheten"
          }
        },
        "nn": {
