    "detail.notePlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. well lit, tight parking, bakery around the corner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. gut beleuchtet, enger Parkplatz, Bäckerei um die Ecke"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "par ex. bien éclairé, parking étroit, boulangerie au coin"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. goed verlicht, krappe parkeerplaats, bakker om de hoek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. godt oplyst, stram parkering, bageri rundt om hjørnet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "esim. hyvin valaistu, tiukka pysäköinti, leipomo nurkan takana"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. väl upplyst, snäv parkering, bageri runt hörnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. καλά φωτισμένο, στενό πάρκινγκ, φούρνος στη γωνία"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "piem. labi apgaismota, šaura stāvvieta, maiznīca aiz stūra"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "pvz. gerai apšviesta, ankšta automobilių stovėjimo aikštelė, kepykla už kampo"
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "z.B. gutt beliichten, knapper Parking, Bäckerei ronderëm den Eck"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "eż. imdawwal tajjeb, ipparkjar issikkat, forn l-kantuniera"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. godt opplyst, trang parkering, bakeri rundt hjørnet"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. godt opplyst, trang parkering, bakeri rundt hjørnet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. dobrze oświetlony, ciasny parking, piekarnia za rogiem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "por exemplo bem iluminado, estacionamento apertado, padaria na esquina"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por ej. bien iluminado, estacionamiento reducido, panadería a la vuelta de la esquina"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "např. dobře osvětlené, těsné parkoviště, pekárna za rohem"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. jól megvilágított, szűk parkoló, pékség a sarkon"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. dobro osvetljeno, tesno parkirišče, pekarna za vogalom"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. ben illuminato, parcheggio stretto, panetteria dietro l'angolo"
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "p.ex. bain illuminà, parcadi stretg, furnaria enturn il chantun"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örneğin iyi aydınlatılmış, dar park yeri, köşede fırın"
          }
        }
      }
    },
