    "seo.topStopsIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr rychlonabíjecích zastávek podle užitečnosti nabíjení a užitečných míst v okolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et udvalg af hurtigladestop rangeret efter ladeværdi og nyttige steder i nærheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Auswahl von Schnellladestopps, sortiert nach Lade-Nutzen und nahen Bäckereien, Restaurants, Läden, Spielplätzen und Cafés."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλογή στάσεων ταχείας φόρτισης με βάση τη χρησιμότητα φόρτισης και χρήσιμα κοντινά μέρη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sample of fast-charging stops ranked by charging usefulness and nearby bakeries, restaurants, shops, playgrounds and cafés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una selección de paradas de carga rápida ordenadas por utilidad de carga y lugares útiles cercanos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valikoima pikalatauspysähdyksiä lataushyödyn ja lähellä olevien hyödyllisten paikkojen mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sélection d’arrêts de recharge rapide classés selon l’utilité de la recharge et les boulangeries, restaurants, boutiques, aires de jeux et cafés à proximité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyorstöltési megállók válogatása töltési hasznosság és közeli hasznos helyek alapján."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una selezione di soste di ricarica rapida ordinate per utilità di ricarica e luoghi utili vicini."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eng Auswiel u Schnellluedstopp no Luednotzen an nëtzleche Plazen an der Géigend."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greitojo įkrovimo sustojimų atranka pagal įkrovimo naudą ir naudingas vietas netoliese."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ātrās uzlādes pieturu izlase pēc uzlādes lietderības un noderīgām vietām tuvumā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għażla ta’ waqfiet ta’ ċċarġjar rapidu skont l-utilità tal-iċċarġjar u postijiet utli fil-qrib."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et utvalg hurtigladestopp rangert etter ladenytte og nyttige steder i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een selectie snellaadstops, gerangschikt op laadnut en nabije bakkerijen, restaurants, winkels, speeltuinen en cafés."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eit utval hurtigladestopp rangert etter ladenytte og nyttige stader i nærleiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór postojów szybkiego ładowania według użyteczności ładowania i przydatnych miejsc w pobliżu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma seleção de paragens de carregamento rápido classificadas por utilidade de carregamento e locais úteis próximos."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ina selecziun da fermadas da chargiar svelt tenor niz da chargiar e lieus utils en vischinanza."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbor postankov hitrega polnjenja po uporabnosti polnjenja in uporabnih krajih v bližini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett urval av snabbladdstopp rangordnade efter laddnytta och nyttiga platser i närheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarj yararı ve yakındaki yararlı yerlere göre sıralanmış hızlı şarj molaları seçkisi."
