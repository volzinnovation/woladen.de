        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-haku latautuu. Tallennetut pikalaturit näkyvät siihen asti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livesökning laddas. Sparade snabbladdare visas fram till dess."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνεται φόρτωση της ζωντανής αναζήτησης. Μέχρι τότε εμφανίζονται οι αποθηκευμένοι γρήγοροι φορτιστές."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiešraides meklēšana tiek ielādēta. Līdz tam tiek rādīti saglabātie ātrie lādētāji."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įkeliama tiesioginė paieška. Iki tol rodomi išsaugoti greitieji įkrovikliai."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Sich gëtt lued. Gespäichert Schnellladeger ginn bis dohin gewisen."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tfittxija diretta qed titgħabba. Sa dakinhar jintwerew chargers veloċi salvati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-søk lastes inn. Lagrede hurtigladere vises frem til da."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-søk lastes inn. Lagrede hurtigladere vises frem til da."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa ładowanie wyszukiwania na żywo. Do tego czasu wyświetlane są zapisane szybkie ładowarki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa ao vivo está carregando. Os carregadores rápidos salvos são mostrados até então."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda en vivo se está cargando. Se muestran los cargadores rápidos guardados hasta ese momento."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé vyhledávání se načítá. Do té doby se zobrazují uložené rychlonabíječky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő keresés betöltődik. Az elmentett gyorstöltők addig láthatók."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iskanje v živo se nalaga. Do takrat so prikazani shranjeni hitri polnilniki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca in tempo reale è in fase di caricamento. Fino ad allora verranno visualizzati i caricatori rapidi salvati."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "La tschertga live vegn chargiada. Chargiaders svelts memorisads vegnan mussads enfin lura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı arama yükleniyor. O zamana kadar kayıtlı hızlı şarj cihazları gösterilir."
          }
        }
      }
    },
