    "location.unknownMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again to load charging stations within 20 km."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte versuche es erneut, um Ladestationen im Umkreis von 20 km zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez réessayer de charger les bornes de recharge dans un rayon de 20 km."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer opnieuw om laadstations binnen 20 km te laden."
          }
        },
