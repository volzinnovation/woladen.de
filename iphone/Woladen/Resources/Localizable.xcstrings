          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandykite dar kartą įkelti įkrovimo stoteles 20 km atstumu."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Probéiert w.e.g. nach eng Kéier fir Opluedstatiounen bannent 20 km ze lueden."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jekk jogħġbok erġa' pprova tagħbija stazzjonijiet tal-iċċarġjar f'20 km."
