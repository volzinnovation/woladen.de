          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź dostępne postoje ładowania w Europie blisko przydatnych miejsc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre paragens de carregamento disponíveis na Europa perto de locais úteis."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatta fermadas da chargiar disponiblas en l’Europa sper lieus utils."
