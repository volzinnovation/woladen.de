    "info.aboutOutro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "charging points in many countries and shows them within 20 km of your location or selected map position. Because charging time should be time well spent. By default, woladen searches fast chargers from 50 kW; the power filter can include normal chargers below 50 kW."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladepunkten in vielen Ländern und zeigt sie im Umkreis von 20 km um deinen Standort oder die gewählte Kartenposition. Denn Ladezeit sollte gut genutzte Zeit sein. Standardmäßig sucht woladen Schnelllader ab 50 kW; über den Leistungsfilter lassen sich auch normale Ladepunkte unter 50 kW einbeziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "charging points in many countries and shows them within 20 km of your location or selected map position. Because charging time should be time well spent. By default, woladen searches fast chargers from 50 kW; the power filter can include normal chargers below 50 kW."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "laadpunten in veel landen en toont ze binnen 20 km van je locatie of geselecteerde kaartpositie. Want laadtijd moet goed bestede tijd zijn. Standaard zoekt woladen snelladers vanaf 50 kW; met de vermogensfilter kun je ook normale laders onder 50 kW meenemen."
          }
        },
        "da": {
