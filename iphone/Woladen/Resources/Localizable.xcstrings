    "seo.countryIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find available EV charging stops across {country} near useful places. Because charging time should be time well spent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde verfügbare Ladestopps in {country} mit nützlichen Orten in der Nähe. Denn Ladezeit sollte gut genutzte Zeit sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des arrêts de recharge disponibles en {country}, avec des lieux utiles à proximité. Le temps de recharge doit être du temps bien utilisé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind beschikbare laadstops in {country} met nuttige plekken in de buurt. Want laadtijd moet goed bestede tijd zijn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find ledige EV-ladestop i {country} nær nyttige steder. Ladetid skal være godt brugt tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä vapaat EV-latauspysähdykset maassa {country} hyödyllisten paikkojen läheltä. Latausajan pitäisi olla hyvin käytettyä aikaa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta lediga EV-laddstopp i {country} nära nyttiga platser. Laddtid ska vara väl använd tid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε διαθέσιμες στάσεις φόρτισης EV σε {country} κοντά σε χρήσιμα μέρη. Ο χρόνος φόρτισης πρέπει να είναι χρήσιμος χρόνος."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodi pieejamas EV uzlādes pieturas valstī {country} pie noderīgām vietām. Uzlādes laikam jābūt lietderīgam laikam."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskite laisvus EV įkrovimo sustojimus šalyje {country} prie naudingų vietų. Įkrovimo laikas turi būti naudingas laikas."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fann disponibel EV-Luedstopp a {country} no bei nëtzleche Plazen. Luedzäit soll gutt genotzt Zäit sinn."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib waqfiet tal-iċċarġjar EV f’{country} ħdejn postijiet utli. Il-ħin tal-iċċarġjar għandu jkun ħin użat tajjeb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige EV-ladestopp i {country} nær nyttige steder. Ladetid bør være godt brukt tid."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn ledige EV-ladestopp i {country} nær nyttige stader. Ladetid bør vere godt brukt tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dostępne postoje ładowania EV w {country} blisko przydatnych miejsc. Czas ładowania powinien być dobrze wykorzystany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre paragens de carregamento VE disponíveis em {country} perto de locais úteis. O tempo de carregamento deve ser tempo bem usado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra paradas de carga VE disponibles en {country} cerca de lugares útiles. El tiempo de carga debe ser tiempo bien aprovechado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte dostupné EV nabíjecí zastávky v {country} poblíž užitečných míst. Čas nabíjení má být dobře využitý čas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj elérhető EV töltési megállókat itt: {country}, hasznos helyek közelében. A töltési idő legyen jól használt idő."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiščite razpoložljive EV polnilne postanke v {country} blizu uporabnih krajev. Čas polnjenja naj bo dobro izkoriščen čas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova soste di ricarica EV disponibili in {country} vicino a luoghi utili. Il tempo di ricarica dovrebbe essere tempo ben speso."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatta fermadas da chargiar EV disponiblas en {country} sper lieus utils. Il temp da chargiar duai esser temp bain utilisà."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{country} içinde yararlı yerlerin yakınında uygun EV şarj molaları bul. Şarj zamanı iyi değerlendirilmiş zaman olmalı."
          }
        }
      }
    },
