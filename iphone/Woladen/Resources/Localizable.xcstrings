    "seo.coverageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the countries currently covered by woladen, with station counts, charging points, and fast-charging locations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, welche Länder woladen aktuell abdeckt, mit Stationszahlen, Ladepunkten und Schnellladestandorten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les pays actuellement couverts par woladen, avec les stations, points de charge et sites de recharge rapide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de landen die woladen momenteel dekt, met aantallen stations, laadpunten en snellaadlocaties."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se de lande woladen dækker i dag med antal stationer, ladepunkter og hurtigladesteder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso woladenin nykyiset maat sekä asemien, latauspisteiden ja pikalatauspaikkojen määrät."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se länderna woladen täcker i dag med antal stationer, laddpunkter och snabbladdningsplatser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τις χώρες που καλύπτει σήμερα το woladen, με αριθμούς σταθμών, σημείων φόρτισης και ταχείας φόρτισης."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skati valstis, ko woladen pašlaik aptver, ar staciju, uzlādes punktu un ātrās uzlādes vietu skaitu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peržiūrėkite šalis, kurias šiuo metu apima woladen, su stotelių, įkrovimo taškų ir greitojo įkrovimo vietų skaičiais."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuck d’Länner déi woladen aktuell ofdeckt, mat Zuelen zu Statiounen, Luedpunkten a Schnellluedplazen."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara l-pajjiżi li woladen ikopri bħalissa, bin-numri ta’ stazzjonijiet, punti tal-iċċarġjar u postijiet ta’ ċċarġjar rapidu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se landene woladen dekker nå, med antall stasjoner, ladepunkter og hurtigladesteder."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjå landa woladen dekkjer no, med tal på stasjonar, ladepunkt og hurtigladestader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz kraje obecnie obsługiwane przez woladen wraz z liczbą stacji, punktów ładowania i lokalizacji szybkiego ładowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja os países atualmente cobertos pela woladen, com estações, pontos de carregamento e locais de carregamento rápido."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los países que cubre actualmente woladen, con estaciones, puntos de carga y ubicaciones de carga rápida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se na země, které woladen aktuálně pokrývá, včetně počtu stanic, nabíjecích bodů a rychlonabíjecích míst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a woladen által jelenleg lefedett országokat az állomások, töltőpontok és gyorstöltő helyek számával."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglejte si države, ki jih woladen trenutno pokriva, s številom postaj, polnilnih točk in lokacij hitrega polnjenja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i paesi attualmente coperti da woladen, con stazioni, punti di ricarica e località di ricarica rapida."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesa ils pajais che woladen cuvra actualmain, cun dumbers da staziuns, puncts da chargiar e lieus da chargiar svelt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "woladen’in şu anda kapsadığı ülkeleri istasyon, şarj noktası ve hızlı şarj konumu sayılarıyla gör."
          }
        }
      }
    },
